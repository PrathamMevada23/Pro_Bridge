# Copy this file to apps/core/.env before starting the core API.

NODE_ENV=development
PRO_BRIDGE_HOST=127.0.0.1
PRO_BRIDGE_PORT=4317
PRO_BRIDGE_LOG_LEVEL=info

# SQLite database path, relative to apps/core unless absolute.
# Use :memory: for temporary local testing.
PRO_BRIDGE_DATABASE_PATH=./data/pro-bridge.db

# Maximum accepted JSON request body size in bytes. The default is 16 MiB,
# which leaves room for syncing long conversations in batches.
PRO_BRIDGE_BODY_LIMIT_BYTES=16777216

# Generate with: openssl rand -hex 32
# Required when NODE_ENV=production. If omitted outside production, the server
# generates an ephemeral token and logs it at startup.
PRO_BRIDGE_LOCAL_TOKEN=

# Comma-separated browser extension origins, for example:
# chrome-extension://abcdefghijklmnopabcdefghijklmnop,moz-extension://...
# In development, any well-formed chrome-extension:// or moz-extension:// origin is
# accepted. Production requires this allowlist.
PRO_BRIDGE_ALLOWED_ORIGINS=
